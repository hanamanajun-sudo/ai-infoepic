---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const counts = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags ?? []) {
    counts.set(t, (counts.get(t) ?? 0) + 1);
  }
}
const tags = Array.from(counts.entries()).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="태그" description="infoepic AI의 전체 태그 목록">
  <section class="wrap head-section">
    <p class="eyebrow">Tag</p>
    <h1>태그</h1>
  </section>
  <section class="wrap cloud-section">
    <div class="cloud">
      {tags.map(([tag, count]) => (
        <a href={`/tag/${encodeURIComponent(tag)}/`}>#{tag} <span>{count}</span></a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .head-section { padding: 48px 24px 24px; }
  .head-section h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); margin: 8px 0 0; }
  .cloud-section { padding: 8px 24px 64px; }
  .cloud { display: flex; flex-wrap: wrap; gap: 10px; }
  .cloud a {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--accent-tint);
    color: var(--accent-deep);
    font-size: 14px;
    font-weight: 600;
  }
  .cloud a span { color: var(--ink-faint); font-weight: 400; margin-left: 4px; }
  .cloud a:hover { background: var(--accent); color: var(--accent-ink); }
</style>
