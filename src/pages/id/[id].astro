---
import idToSlug from '../../data/id_to_slug.json';

export async function getStaticPaths() {
  return Object.entries(idToSlug as Record<string, string>).map(([id, slug]) => ({
    params: { id },
    props: { slug },
  }));
}

const { slug } = Astro.props;
const target = `/entry/${slug}/`;
const canonicalURL = new URL(target, Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <link rel="canonical" href={canonicalURL} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex" />
    <title>이동 중...</title>
  </head>
  <body>
    <p>페이지를 이동하고 있습니다. 자동으로 이동하지 않으면 <a href={target}>여기를 클릭</a>하세요.</p>
  </body>
</html>
