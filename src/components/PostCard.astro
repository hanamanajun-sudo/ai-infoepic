---
import type { CollectionEntry } from 'astro:content';
import { postHref } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const { title, date, category, description, thumbnail } = post.data;
const dateLabel = new Date(date).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<a class:list={['card', { featured }]} href={postHref(post.data.slug)}>
  <div class="thumb-wrap">
    {thumbnail ? (
      <img src={thumbnail} alt={title} loading="lazy" />
    ) : (
      <div class="thumb-fallback" aria-hidden="true">∴</div>
    )}
  </div>
  <div class="card-body">
    {category && <span class="pill">{category}</span>}
    <h3 class="card-title">{title}</h3>
    {description && <p class="card-desc">{description}</p>}
    <time class="card-date" datetime={date}>{dateLabel}</time>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    height: 100%;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
  }
  .thumb-wrap {
    aspect-ratio: 16 / 10;
    background: var(--accent-tint);
    overflow: hidden;
  }
  .thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 40px;
    color: var(--accent-deep);
    opacity: 0.5;
  }
  .card-body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .card-title {
    font-size: 1.05rem;
    margin: 2px 0 0;
    line-height: 1.4;
  }
  .card-desc {
    font-size: 14px;
    color: var(--ink-soft);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-date {
    margin-top: auto;
    font-size: 12.5px;
    color: var(--ink-faint);
    padding-top: 6px;
  }
  .featured .thumb-wrap {
    aspect-ratio: 16 / 9;
  }
  .featured .card-title {
    font-size: 1.4rem;
  }
</style>
